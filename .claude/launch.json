{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend-demo",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--port", "8001"],
      "env": { "FORCE_FALLBACK": "1" },
      "port": 8001
    },
    {
      "name": "frontend-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "start", "--", "--port", "3001"],
      "port": 3001
    }
  ]
}
