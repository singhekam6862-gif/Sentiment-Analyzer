# Copy to backend/.env (gitignored) and start the server with:
#   uvicorn app.main:app --reload --env-file .env
# Every key is optional: with none set, the AI summary uses the rule-based fallback.

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Order the providers are tried in; the first valid answer wins.
LLM_PROVIDERS=groq,gemini

# Providers retire models often. If calls start failing, set a current model id here.
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.8-flash

